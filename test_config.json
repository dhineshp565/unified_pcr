{
  "preprocessing": {
    "min_quality": 7.0,
    "min_length": 100,
    "max_length": 10000,
    "trim_adapters": true,
    "adapter_sequences": []
  },
  "alignment": {
    "preset": "map-ont",
    "threads": 4,
    "min_mapping_quality": 20
  },
  "variant_calling": {
    "min_coverage": 10,
    "min_variant_frequency": 0.2,
    "min_base_quality": 7
  },
  "coverage_analysis": {
    "min_coverage": 10,
    "report_format": "bed"
  },
  "output": {
    "output_dir": "./ont_targseq_output",
    "keep_intermediates": true
  }
}